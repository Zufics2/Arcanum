# Django
# Generate command: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Needed only when the frontend runs on a different origin (npm run dev on :3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:3000

# PostgreSQL
POSTGRES_DB=arcanum
POSTGRES_USER=arcanum
POSTGRES_PASSWORD=change-me
# Inside Docker the host is "db"; for local runserver use localhost
DATABASE_URL=postgres://arcanum:change-me@db:5432/arcanum

# Nginx
HTTP_PORT=80
